---
import "#/presentation/shared/design_system/styles/app.css";

import { Font } from "astro:assets";

import DevSwitcherChoice from "#/presentation/shared/document/ui/DevSwitcherChoice.astro";
import SeoHead from "#/presentation/shared/document/ui/SeoHead.astro";

/** The shell every page renders in: `<html>`, `<head>`, `<body>`. */
interface Props {
    title: string;
    description: string;
    noindex?: boolean;
    /** The page's language: French for the French legal notice, English elsewhere. */
    lang?: "en" | "fr";
    alternates?: readonly { readonly lang: string; readonly href: string }[];
}

const {
    title,
    description,
    noindex = false,
    lang = "en",
    alternates = [],
} = Astro.props;
// The switcher design this visit sees: card here, rewritten per visit by the
// edge. In development only, `?switcher=card|shelf` forces one for the tab.
const isDev = import.meta.env.DEV;
---

<!doctype html>
<html lang={lang} data-switcher="card">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        {isDev && <DevSwitcherChoice />}
        <SeoHead
            title={title}
            description={description}
            noindex={noindex}
            lang={lang}
            alternates={alternates}
        />
        <Font cssVariable="--font-caslon" preload />
        <Font cssVariable="--font-hanken" preload />
        <Font cssVariable="--font-dm-mono" />
    </head>
    <body>
        <slot />
        <script>
            import { initReveal } from "#/presentation/shared/reveal/behaviour/reveal.ts";

            initReveal(document);
        </script>
    </body>
</html>
