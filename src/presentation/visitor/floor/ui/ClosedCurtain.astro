---
import RoomCurtain from "#/presentation/visitor/floor/ui/RoomCurtain.astro";
import {
    closedFloorCurtain,
    closedPathCurtain,
    closedPhoneCurtain,
} from "#/presentation/visitor/floor/presenters/curtainShapes.ts";
import type { ClosedCardViewModel } from "#/presentation/visitor/floor/viewmodels/ClosedFloorViewModel.ts";

/**
 * A page not written yet, closed: one cinema curtain (a floor's 950 × 270, or
 * the engineering home's 1100 × 270; 358 × 240 on a phone) and one title card,
 * the name and "Coming later". It stays closed: not a button, not a link.
 */
interface Props {
    card: ClosedCardViewModel;
    width: "floor" | "path";
}

const { card, width } = Astro.props;
const wide = width === "floor" ? closedFloorCurtain : closedPathCurtain;
---

<div class="closed" data-closed={width}>
    <RoomCurtain
        shape={wide}
        part="all"
        viewBox={`0 0 ${wide.width} ${wide.height}`}
        id={`closed-${width}-wide`}
        class="closed-wide"
    />
    <RoomCurtain
        shape={closedPhoneCurtain}
        part="all"
        viewBox="0 0 358 240"
        id={`closed-${width}-phone`}
        class="closed-phone"
    />
    <p class="room-card closed-card">
        <span class="room-card-name">{card.name}</span>
        <span aria-hidden="true" class="room-card-rule"></span>
        <span class="room-card-later">{card.later}</span>
    </p>
</div>
