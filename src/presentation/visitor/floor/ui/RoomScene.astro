---
import TwoDoors from "#/presentation/visitor/floor/ui/scenes/TwoDoors.astro";
import MagicLantern from "#/presentation/visitor/floor/ui/scenes/MagicLantern.astro";

/**
 * A published room's scene, by the name in the floor's data: the magic
 * lantern, or the two doors.
 * A room named with an unknown scene shows none.
 */
interface Props {
    scene: string;
    id: string;
}

const { scene, id } = Astro.props;
---

{scene === "magicLantern" && <MagicLantern id={id} />}
{scene === "twoDoors" && <TwoDoors />}
