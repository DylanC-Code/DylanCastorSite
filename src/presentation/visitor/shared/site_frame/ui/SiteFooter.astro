---
import type { SiteFooterViewModel } from "#/presentation/visitor/shared/site_frame/viewmodels/SiteFooterViewModel.ts";

type Props = SiteFooterViewModel;

const { left, legalHref, right } = Astro.props;
// "Dylan Castor · Legal notice": the words after the dot link to the notice.
const [name, legal] = left.split(" · ");
---

<footer class="flex items-center justify-between gap-6 border-t border-line px-4 pt-5 pb-21 text-[12px] text-ink-faint md:px-30 md:py-6 md:text-label">
    <span>
        {name} ·{" "}
        <a href={legalHref} class="text-ink-faint hover:text-ink">
            {legal}
        </a>
    </span>
    <a href={right.href} class="link-accent text-[13px] md:text-small">
        {right.label}
    </a>
</footer>
