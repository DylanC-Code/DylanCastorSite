---
import ReaderBook from "#/presentation/visitor/home/ui/ReaderBook.astro";
import { withReader } from "#/presentation/visitor/home/presenters/bookNames.ts";
import type { BookViewModel } from "#/presentation/visitor/home/viewmodels/BookViewModel.ts";
import type { PathHeroViewModel } from "#/presentation/visitor/shared/path_hero/viewmodels/PathHeroViewModel.ts";

/**
 * A reading path home's first screen (agencies, brands): the words left;
 * right, that path's book of the root home, opening once on its contents. The book only shows: it is
 * inert and hidden from assistive tech, its words being the page's own.
 */
interface Props {
    hero: PathHeroViewModel;
    book: BookViewModel;
    contentsLabel: string;
    coverFoot: string;
    openAria: string;
}

const { hero, book, contentsLabel, coverFoot, openAria } = Astro.props;
---

<section class="page flex flex-col gap-12 pt-10 pb-16 md:pt-16 md:pb-21 min-[1280px]:min-h-[calc(100svh-var(--header-height))] min-[1280px]:flex-row min-[1280px]:items-center min-[1280px]:gap-0">
    <div class="max-w-150 min-w-0 flex-1">
        <p class="eyebrow">{hero.eyebrow}</p>
        <h1 class="mt-5 font-display text-[29px] leading-[1.06] text-ink md:text-[52px]">
            {hero.title[0]}
            <br />
            <em class="italic">{hero.title[1]}</em>
        </h1>
        <p class="mt-6 max-w-130 text-body-lg text-ink-muted">{hero.lead}</p>
        <div
            class:list={[
                "mt-9 flex items-center gap-6 md:gap-8",
                hero.stackedActions &&
                    "max-md:flex-col max-md:items-stretch max-md:gap-5 max-md:text-center",
            ]}
        >
            <a href={hero.button.href} class="btn max-md:flex-1 max-md:px-4">
                {hero.button.label}
            </a>
            <a href={hero.down.href} class="link-accent shrink-0">
                {hero.down.label}
            </a>
        </div>
    </div>
    <div class="hero-book" aria-hidden="true" inert>
        <ReaderBook
            book={book}
            index={0}
            contentsLabel={contentsLabel}
            coverFoot={coverFoot}
            openLabel={withReader(openAria, book)}
        />
    </div>
</section>

<style>
    /* The book at 0.8, its cover swung open once onto the endpaper; below
       1280px under the words, centred. */
    /*
     * On a phone, under the words, the open spread (704 units) as wide as
     * the column; centred.
     */
    .hero-book {
        --u: calc((100vw - 32px) / 704);
        position: relative;
        flex: none;
        width: calc(352 * var(--u));
        height: calc(520 * var(--u));
        margin-left: 50%;
    }

    @media (min-width: 48rem) {
        .hero-book {
            --u: 0.8px;
        }
    }

    /*
     * From 1280px, beside the words: the book takes its closed width, so its
     * margin keeps room for the cover swung open on its left, and 40px more.
     */
    @media (min-width: 80rem) {
        .hero-book {
            margin-left: calc(352 * var(--u) + 40px);
        }
    }

    /* The shelf sets its own scale on a phone: here the book takes the hero's. */
    .hero-book :global(.book) {
        --u: inherit;
        position: relative;
        top: 0;
        left: 0;
    }

    .hero-book :global(.book-cover) {
        animation: hero-book-opens var(--duration-book-open) var(--ease-mech)
            500ms both;
    }

    @keyframes hero-book-opens {
        to {
            transform: translateZ(0) rotateY(-180deg);
        }
    }
</style>
