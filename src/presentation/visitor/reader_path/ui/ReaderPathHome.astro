---
import type { ComponentProps } from "astro/types";

import AgenciesPage from "#/presentation/visitor/agencies/ui/AgenciesPage.astro";
import BrandsPage from "#/presentation/visitor/brands/ui/BrandsPage.astro";
import type { BrandsPageViewModel } from "#/presentation/visitor/brands/viewmodels/BrandsPageViewModel.ts";
import type { BookViewModel } from "#/presentation/visitor/home/viewmodels/BookViewModel.ts";
import ClosedPath from "#/presentation/visitor/reader_path/ui/ClosedPath.astro";
import type { ClosedPathViewModel } from "#/presentation/visitor/reader_path/viewmodels/ClosedPathViewModel.ts";

/**
 * A reading path's home, by its book: the agencies home, the brands home, or
 * the closed curtain of a path not written yet (the engineering home).
 */
interface Props {
    book: BookViewModel;
    labels: ComponentProps<typeof AgenciesPage>["labels"];
    agencies: Omit<ComponentProps<typeof AgenciesPage>, "book" | "labels">;
    brands: BrandsPageViewModel;
    closed: ClosedPathViewModel;
}

const { book, labels, agencies, brands, closed } = Astro.props;
---

{book.id === "agencies" && (
    <AgenciesPage {...agencies} book={book} labels={labels} />
)}
{book.id === "brands" && (
    <BrandsPage page={brands} book={book} labels={labels} />
)}
{book.id !== "agencies" && book.id !== "brands" && <ClosedPath {...closed} />}
<span hidden data-reader-path={book.id} />

<script>
    import { carryPath } from "#/presentation/visitor/shared/path_memory/behaviour/pathVia.ts";

    const path = document.querySelector<HTMLElement>("[data-reader-path]");
    const { readerPath } = path?.dataset ?? {};
    if (readerPath !== undefined) {
        carryPath(document, readerPath);
    }
</script>
