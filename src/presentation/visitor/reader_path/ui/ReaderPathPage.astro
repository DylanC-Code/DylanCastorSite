---
import type { ReaderPathPageViewModel } from "#/presentation/visitor/reader_path/viewmodels/ReaderPathPageViewModel.ts";

/** A reading path's page, until it is written (handoff, open item 3). */
type Props = ReaderPathPageViewModel;

const { title } = Astro.props;
---

<section class="page py-24">
    <h1 class="font-display text-section-sm text-ink md:text-section">
        {title}
    </h1>
    <p class="mt-4 text-body text-ink-muted">This page is being written.</p>
</section>
