---
import type { TitlePageViewModel } from "#/presentation/visitor/home/viewmodels/TitlePageViewModel.ts";

type Props = TitlePageViewModel;

/**
 * The first screen, a plate with a double frame. The motion is CSS only and
 * plays once; the title is in the HTML, so it reads with no script.
 */
const hero = Astro.props;
const ticks = [
    "top-3.5 left-3.5 border-t border-l",
    "top-3.5 right-3.5 border-t border-r",
    "bottom-3.5 left-3.5 border-b border-l",
    "right-3.5 bottom-3.5 border-r border-b",
];
---

<section class="page pt-6 pb-9 md:pt-10.5 md:pb-24">
    <div class="relative mx-auto w-full max-w-235 p-1.75 md:h-160 md:p-2">
        <span
            aria-hidden="true"
            class="title-edge title-draw-x inset-x-0 top-0 h-px"
        ></span>
        <span
            aria-hidden="true"
            class="title-edge title-draw-y inset-y-0 left-0 w-px"
        ></span>
        <span
            aria-hidden="true"
            class="title-edge title-draw-x inset-x-0 bottom-0 h-px"
            style="--d: 150ms"
        ></span>
        <span
            aria-hidden="true"
            class="title-edge title-draw-y inset-y-0 right-0 w-px"
            style="--d: 150ms"
        ></span>
        <span
            aria-hidden="true"
            class="title-fade pointer-events-none absolute inset-1.75 border border-line md:inset-2"
            style="--d: 700ms"
        ></span>
        {ticks.map((tick) => (
            <span
                aria-hidden="true"
                class:list={[
                    "title-fade absolute size-4 border-accent max-md:hidden",
                    tick,
                ]}
                style="--d: 1300ms"
            />
        ))}
        <div class="relative flex h-full flex-col items-center px-5 pt-10 pb-7.5 text-center md:pt-18.5">
            <p class="eyebrow title-rise" style="--d: 500ms">
                {hero.eyebrow}
            </p>
            <h1 class="mt-6.5 font-display text-hero-sm text-ink md:mt-8.5 md:text-hero">
                <span class="title-line">
                    <span style="--d: 700ms">{hero.titleLine1}</span>
                </span>
                <span class="title-line">
                    <span style="--d: 840ms">
                        <em class="italic">{hero.titleLine2Italic}</em>
                    </span>
                </span>
            </h1>
            <span
                aria-hidden="true"
                class="title-rule mt-6.5 block h-px w-22.5 bg-accent md:mt-9 md:w-40"
            ></span>
            <p
                class="title-rise mt-5.5 max-w-150 text-body text-ink-muted md:mt-7.5 md:text-[19px] md:leading-7.5"
                style="--d: 1500ms"
            >
                {hero.lead}
            </p>
            <div
                class="title-rise mt-7 flex w-full flex-col items-center gap-4 md:mt-9 md:w-auto md:flex-row md:gap-8"
                style="--d: 1700ms"
            >
                <a href={hero.primary.href} class="btn w-full md:w-auto">
                    {hero.primary.label}
                </a>
                <a href={hero.secondary.href} class="link-accent">
                    {hero.secondary.label}
                </a>
            </div>
            <p
                class="title-rise mt-7.5 text-[9px] leading-none font-medium tracking-[.22em] text-ink-faint uppercase md:absolute md:inset-x-0 md:bottom-10 md:mt-0 md:text-cap-sm"
                style="--d: 2000ms"
            >
                {hero.foot}
            </p>
        </div>
    </div>
</section>
