---
import type { GettingAroundViewModel } from "#/presentation/visitor/home/viewmodels/GettingAroundViewModel.ts";

type Props = GettingAroundViewModel;

const { eyebrow, title, items } = Astro.props;
---

<section class="page py-10 md:py-24">
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="mt-3 font-display text-section-sm text-ink md:mt-4 md:text-[44px] md:leading-[1.1]">
        {title}
    </h2>
    <div data-reveal class="mt-8 grid gap-6 md:mt-12 md:grid-cols-3 md:gap-12">
        {items.map((tip, index) => (
            <div data-rise style={`--i: ${index}`}>
                <span aria-hidden="true" class="block h-px w-8 bg-accent" />
                <h3 class="mt-5 text-heading font-semibold text-ink">
                    {tip.title}
                </h3>
                <p class="mt-2.5 text-body text-ink-muted">{tip.text}</p>
            </div>
        ))}
    </div>
</section>
