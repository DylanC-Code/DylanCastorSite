---
import type { ContactCardViewModel } from "#/presentation/visitor/home/viewmodels/ContactCardViewModel.ts";

type Props = ContactCardViewModel;

const { eyebrow, titleStart, titleItalic, text, button } = Astro.props;
---

<section class="page py-10 md:pt-10 md:pb-24">
    <div
        id="contact"
        data-reveal
        data-rise
        class="card flex flex-col items-start gap-8 border border-line-strong bg-surface-lift px-5.5 py-7.5 md:flex-row md:items-center md:justify-between md:gap-12 md:px-16 md:py-14"
    >
        <div>
            <p class="eyebrow">{eyebrow}</p>
            <h2 class="mt-4.5 font-display text-section-sm text-ink md:text-section">
                {titleStart} <em class="italic">{titleItalic}</em>
            </h2>
            <p class="mt-4.5 max-w-140 text-body text-ink-muted md:text-[17px] md:leading-7">
                {text}
            </p>
        </div>
        <a href={button.href} class="btn max-md:w-full">
            {button.label}
        </a>
    </div>
</section>

<style>
    .card {
        box-shadow:
            inset 0 0 0 5px var(--color-surface-lift),
            inset 0 0 0 6px var(--color-line);
    }
</style>
