---
import marbleUrl from "#/presentation/shared/design_system/marks/marble.svg?url";
import ReaderBook from "#/presentation/visitor/home/ui/ReaderBook.astro";
import type { ReaderShelfViewModel } from "#/presentation/visitor/home/viewmodels/ReaderShelfViewModel.ts";

type Props = ReaderShelfViewModel;

const { eyebrow, title, lead, back, books, coverFoot, pageEyebrowPrefix } =
    Astro.props;
---

<section id="paths" class="page py-10 md:py-24">
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="mt-3 font-display text-section-sm text-ink md:mt-4 md:text-section">
        {title}
    </h2>
    <p class="mt-3 max-w-160 text-[15px] leading-6 text-ink-muted md:mt-4 md:text-[17px] md:leading-7">
        {lead}
    </p>
    <div
        class="shelf mt-6.5 md:mt-13"
        data-shelf
        data-reveal
        style={`--marble: url("${marbleUrl}")`}
    >
        <div class="books">
            {books.map((book, index) => (
                <ReaderBook
                    book={book}
                    index={index}
                    coverFoot={coverFoot}
                    pageEyebrowPrefix={pageEyebrowPrefix}
                />
            ))}
        </div>
        <p class="book-hint">Tap a book to open it.</p>
        <button type="button" class="back-to-shelf" data-shelf-back>
            {back}
        </button>
    </div>
</section>

<script>
    import { initReaderBooks } from "#/presentation/visitor/home/behaviour/readerBooks.ts";

    for (const shelf of document.querySelectorAll("[data-shelf]")) {
        if (shelf instanceof HTMLElement) {
            initReaderBooks(shelf);
        }
    }
</script>
