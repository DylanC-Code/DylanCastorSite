---
import Bookmark from "#/presentation/visitor/home/ui/Bookmark.astro";
import ReaderBook from "#/presentation/visitor/home/ui/ReaderBook.astro";
import { withReader } from "#/presentation/visitor/home/presenters/bookNames.ts";
import type { ReaderShelfViewModel } from "#/presentation/visitor/home/viewmodels/ReaderShelfViewModel.ts";

/**
 * "Who are you?": three books cover-out. One opens on its contents, its pages
 * turn with the arrows at the corners, and its bookmark leads on. The
 * controls wait hidden until script brings the books to life.
 */
type Props = ReaderShelfViewModel;

const { head, labels, books } = Astro.props;
const arrow = "M1 5 H37 M32 1.5 L37.5 5 L32 8.5";
---

<section class="page py-10 md:py-24">
    <p id="paths" class="eyebrow">
        {head.eyebrow}
    </p>
    <h2 class="mt-3 font-display text-section-sm text-ink md:mt-4 md:text-section">
        {head.title}
    </h2>
    <p class="mt-3 max-w-160 text-[14px] leading-6 text-ink-muted md:mt-9 md:text-[17px] md:leading-7">
        {head.lead}
    </p>
    <div class="shelf mt-12 md:mt-13" data-shelf data-reveal>
        <div class="stage">
            {books.map((book) => (
                <Bookmark book={book} />
            ))}
            {books.map((book, index) => (
                <ReaderBook
                    book={book}
                    index={index}
                    contentsLabel={labels.contents}
                    coverFoot={labels.coverFoot}
                    openLabel={withReader(labels.openAria, book)}
                />
            ))}
            <button
                type="button"
                class="page-arrow is-prev"
                data-page-prev
                aria-label={labels.prevAria}
                hidden
            >
                <svg
                    aria-hidden="true"
                    width="40"
                    height="10"
                    viewBox="0 0 40 10"
                >
                    <path d={arrow}></path>
                </svg>
            </button>
            <button
                type="button"
                class="page-arrow is-next"
                data-page-next
                aria-label={labels.nextAria}
                hidden
            >
                <svg
                    aria-hidden="true"
                    width="40"
                    height="10"
                    viewBox="0 0 40 10"
                >
                    <path d={arrow}></path>
                </svg>
            </button>
            <button type="button" class="back-to-shelf" data-shelf-back hidden>
                {labels.back}
            </button>
            <p class="book-hint">{labels.phoneHint}</p>
        </div>
    </div>
</section>

<script>
    import { initReaderBooks } from "#/presentation/visitor/home/behaviour/readerBooks.ts";

    for (const shelf of document.querySelectorAll("[data-shelf]")) {
        if (shelf instanceof HTMLElement) {
            initReaderBooks(shelf);
        }
    }
</script>
