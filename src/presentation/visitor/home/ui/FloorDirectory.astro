---
import type { FloorDirectoryViewModel } from "#/presentation/visitor/home/viewmodels/FloorDirectoryViewModel.ts";

type Props = FloorDirectoryViewModel;

/** The directory board: each floor of the work and how I work on it. */
const { eyebrow, title, columns, rows, method } = Astro.props;
const row =
    "grid grid-cols-[34px_1fr] items-center gap-x-3.5 gap-y-2.5 py-4 md:grid-cols-[80px_300px_1fr] md:gap-6 md:py-5";
const area =
    "text-[13px] leading-none font-semibold tracking-[.14em] text-ink uppercase md:text-[15px] md:tracking-[.16em]";
const how =
    "col-span-2 text-small text-ink-muted md:col-span-1 md:text-[15px] md:leading-6";
---

<section class="page py-10 md:py-24">
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="mt-3 font-display text-section-sm text-ink md:mt-4 md:text-section">
        {title}
    </h2>
    <div
        data-reveal
        class="board mt-6.5 border border-line-strong bg-board px-4.5 pt-4.5 pb-2 md:mt-12 md:px-14 md:pt-8.5 md:pb-6.5"
    >
        <div class="grid grid-cols-[80px_300px_1fr] gap-6 pb-4 max-md:hidden">
            {columns.map((column) => (
                <span class="text-cap-sm font-medium text-accent uppercase">
                    {column}
                </span>
            ))}
        </div>
        {rows.map((floor, index) => (
            <div
                data-wipe
                style={`--i: ${index}`}
                class:list={[
                    row,
                    "border-t border-accent/16",
                    index === 0 && "max-md:border-transparent",
                ]}
            >
                <span
                    class:list={[
                        "font-display text-[26px] leading-none text-accent md:text-[34px]",
                        floor.comingLater === true && "opacity-50",
                    ]}
                >
                    {floor.numeral}
                </span>
                <span class="flex flex-col gap-1.5 md:gap-1.75">
                    <span
                        class:list={[
                            area,
                            floor.comingLater === true && "text-ink-faint",
                        ]}
                    >
                        {floor.area}
                    </span>
                    <span class="text-[8px] leading-none font-medium tracking-[.22em] text-ink-faint uppercase md:text-cap-sm">
                        {floor.layer}
                    </span>
                </span>
                <p
                    class:list={[
                        how,
                        floor.comingLater === true && "text-ink-faint",
                    ]}
                >
                    {floor.how}
                </p>
            </div>
        ))}
        <div
            data-wipe
            style={`--i: ${rows.length}`}
            class:list={[row, "border-t border-accent/32 md:pb-1.5"]}
        >
            <em class="font-display text-[22px] leading-none text-accent italic md:text-[24px]">
                {method.numeralItalic}
            </em>
            <span class={area}>{method.area}</span>
            <p class={how}>{method.how}</p>
        </div>
    </div>
</section>

<style>
    .board {
        box-shadow:
            inset 0 0 0 5px var(--color-board),
            inset 0 0 0 6px rgb(227 154 106 / 0.32);
    }

    @media (min-width: 48rem) {
        .board {
            box-shadow:
                inset 0 0 0 6px var(--color-board),
                inset 0 0 0 7px rgb(227 154 106 / 0.32),
                var(--shadow-lift);
        }
    }
</style>
