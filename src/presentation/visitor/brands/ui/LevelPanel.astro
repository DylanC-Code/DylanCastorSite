---
import type { HouseLevelViewModel } from "#/presentation/visitor/brands/viewmodels/StoreHouseViewModel.ts";

/** What a level is about: its caption, name, sentence and three points. */
interface Props {
    level: HouseLevelViewModel;
    index: number;
}

const { level, index } = Astro.props;
---

<div
    role="tabpanel"
    id={`house-panel-${index}`}
    aria-labelledby={`house-tab-${index}`}
    class:list={["level-panel", index === 0 && "is-chosen"]}
>
    <p class="eyebrow">{level.caption}</p>
    <h3 class="mt-2.5 font-display text-[32px] leading-[1.08] text-ink md:text-[42px]">
        {level.name}
    </h3>
    <p class="mt-4 font-display text-[19px] leading-[1.4] text-ink md:text-[22px]">
        {level.sentence}
    </p>
    <ul class="level-points">
        {level.points.map((point) => (
            <li>{point}</li>
        ))}
    </ul>
</div>
