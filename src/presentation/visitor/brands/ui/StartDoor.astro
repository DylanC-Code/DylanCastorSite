---
import type { StartDoorViewModel } from "#/presentation/visitor/brands/viewmodels/StartDoorViewModel.ts";

/**
 * "How we start": the words left; right, a shop door in copper lines under a
 * striped awning, a paper sign on its glass ("Come in with one task"), and
 * beside it an enamel plate ("Then: days per month"). The door opens a little,
 * once, 700ms after the part comes into view. The drawing only shows.
 */
type Props = StartDoorViewModel;

const { title, titleItalic, sentence, emphasis, text, sign, plate } =
    Astro.props;
const [before = "", after = ""] = sentence.split(emphasis);
---

<section
    class="page mt-30 md:mt-[190px]"
    data-reveal
    aria-labelledby="start-title"
>
    <div class="start-grid">
        <div class="max-w-[440px]">
            <h2 id="start-title" class="section-title">
                {title} <em class="italic">{titleItalic}</em>
            </h2>
            <p class="mt-[22px] font-display text-[19px] leading-[1.42] text-ink md:text-[22px]">
                {before}
                <em class="text-accent italic">{emphasis}</em>
                {after}
            </p>
            <p class="mt-3.5 text-[17px] leading-[27px] text-ink-muted">
                {text}
            </p>
        </div>
        <div class="start-scene" aria-hidden="true">
            <div class="start-front">
                <span class="start-awning" />
                <span class="start-frame">
                    <span class="start-door">
                        <span class="start-glass" />
                        <span class="start-panel" />
                        <span class="start-knob" />
                        <span class="start-string" />
                        <span class="start-sign">
                            <span class="paper-cap">{sign[0]}</span>
                            <span class="start-sign-words">{sign[1]}</span>
                        </span>
                    </span>
                </span>
                <span class="start-floor" />
            </div>
            <span class="start-plate">
                <span class="start-plate-cap">{plate[0]}</span>
                <span class="start-plate-words">
                    {plate[1]} <em>{plate[2]}</em>
                </span>
            </span>
        </div>
    </div>
</section>
