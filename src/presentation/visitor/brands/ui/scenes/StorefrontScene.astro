<style>
    /*
     * Geometry at the scene's weight; the animations under :where(), so the
     * house's still and reduced-motion rules (houseScene.css) always win.
     */
    .scene .bar {
        transform-origin: 0 50%;
    }

    :where(.bar) {
        animation: storefront-grow 2600ms linear 900ms both;
    }

    :where(.walker) {
        animation: storefront-walk 4200ms linear var(--delay) infinite both;
    }

    @keyframes storefront-grow {
        from {
            transform: scaleX(0);
        }

        to {
            transform: scaleX(1);
        }
    }

    @keyframes storefront-walk {
        0% {
            transform: translateX(0);
            opacity: 0;
        }

        10% {
            opacity: 1;
        }

        86% {
            opacity: 1;
        }

        100% {
            transform: translateX(var(--d));
            opacity: 0;
        }
    }
</style>
