---
import KeyText from "#/presentation/visitor/flicker/ui/KeyText.astro";
import type { KeyRun } from "#/presentation/visitor/flicker/presenters/keyRuns.ts";
import type { Versioned } from "#/presentation/visitor/flicker/viewmodels/Versioned.ts";

/**
 * A text in two versions. The brand wording is the page's own (what a search
 * engine and a visitor without script read); the agency wording waits in a
 * template, put in place for a visitor who came through the agencies home.
 */
interface Props {
    text: Versioned<readonly KeyRun[]>;
}

const { text } = Astro.props;
---

<span data-versioned>
    <template>
        <KeyText runs={text.agency} />
    </template>
    <KeyText runs={text.brand} />
</span>
