---
/**
 * The signpost, desktop: a post on the ground with two boards, the usual way
 * pointing left and without flicker pointing right, the gentleman at its foot,
 * a milestone at each end and a caption with an arrow under each board.
 * Prototype: `signSec`, the 1000 × 340 drawing.
 */
import VisitorFigure from "#/presentation/visitor/floor/ui/VisitorFigure.astro";

interface Props {
    boards: readonly [string, string];
    captions: readonly [string, string];
    label: string;
}

const { boards, captions, label } = Astro.props;
const hatch = Array.from(
    { length: 65 },
    (_, i) => `M${50 + i * 14} 304l-7 9`,
).join("");
const post = "M492 50h16V300h-16zM489 44h22v7h-22zM500 22l9 22h-18z";
const postGrain = "M504 58V296M501 88V270";
const mound = "M480 296l-4 -7M486 294l-1 -8M518 295l4 -7M524 297l5 -5";
const stones =
    "M71 300v-24a13 13 0 0 1 26 0v24zM903 300v-24a13 13 0 0 1 26 0v24z";
const stoneLines =
    "M77 278h14M77 285h14M90 270v26M909 278h14M909 285h14M922 270v26";
---

<svg
    class="scene-signpost"
    viewBox="0 0 1000 340"
    role="img"
    aria-label={label}
>
    <path class="l" d="M40 300H960"></path>
    <path class="h" d={hatch}></path>
    <path class="f" d={post}></path>
    <path class="h" d={postGrain}></path>
    <circle class="f" cx="500" cy="19" r="4"></circle>
    <path class="l" d="M470 300c6 -11 54 -11 60 0"></path>
    <path class="h" d={mound}></path>
    <path class="f" d="M491 58H201L165 86L201 114H491z"></path>
    <path class="h" d="M485 64H204L174 86L204 108H485z"></path>
    <path
        class="h"
        d="M462 73H404M331.5 79H230M456.2 98H369.2M311.2 103H215.5"
    ></path>
    <circle class="c" cx="475" cy="75" r="2"></circle>
    <circle class="c" cx="475" cy="97" r="2"></circle>
    <text class="b" x="332" y="94" text-anchor="middle">
        {boards[0]}
    </text>
    <path class="f" d="M509 130H799L835 158L799 186H509z"></path>
    <path class="h" d="M515 136H796L826 158L796 180H515z"></path>
    <path
        class="h"
        d="M538 145H596M668.5 151H770M543.8 170H630.8M688.8 175H784.5"
    ></path>
    <circle class="c" cx="525" cy="147" r="2"></circle>
    <circle class="c" cx="525" cy="169" r="2"></circle>
    <text class="b" x="668" y="166" text-anchor="middle">
        {boards[1]}
    </text>
    <VisitorFigure x={372} y={132} width={90} height={168} />
    <path class="f" d={stones}></path>
    <path class="h" d={stoneLines}></path>
    <text class="w" x="118" y="262">
        {captions[0]}
    </text>
    <path class="l" d="M118 280h-0M150 282H118M127 276l-9 6l9 6"></path>
    <text class="w" x="882" y="262" text-anchor="end">
        {captions[1]}
    </text>
    <path class="l" d="M850 282h32M873 276l9 6l-9 6"></path>
</svg>

<style>
    .scene-signpost {
        display: block;
        overflow: visible;
    }

    .l {
        fill: none;
        stroke: rgb(227 154 106 / 0.85);
        stroke-width: 1.3;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .f {
        fill: var(--color-ground);
        stroke: rgb(227 154 106 / 0.85);
        stroke-width: 1.3;
        stroke-linejoin: round;
    }

    .h {
        fill: none;
        stroke: rgb(227 154 106 / 0.4);
        stroke-width: 0.9;
        stroke-linecap: round;
    }

    .c {
        fill: rgb(227 154 106 / 0.85);
    }

    .b {
        font: 400 24px var(--font-display);
        fill: var(--color-ink);
    }

    .w {
        font: italic 21px var(--font-display);
        fill: var(--color-ink);
    }
</style>
