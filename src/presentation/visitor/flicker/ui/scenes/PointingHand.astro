---
/**
 * The pointing hand beside "Continued below": a gloved hand, cuff at the top,
 * one finger pointing down, outlined in copper. Prototype: `cuHand`.
 */
---

<svg
    class="pointing-hand"
    viewBox="-1 0 43 62"
    aria-hidden="true"
    focusable="false"
>
    <path class="f" d="M30 12c6 0 10 4 10 10s-4 8-9 8z"></path>
    <path
        class="f"
        d="M6 10h28v25a3.5 3.5 0 0 1-7 0a3.5 3.5 0 0 1-7 0a3.5 3.5 0 0 1-7 0v21a3.5 3.5 0 0 1-7 0z"
    ></path>
    <path class="h" d="M27 35v-10M20 35v-10M13 35v-12"></path>
    <path class="f" d="M8 1h24v9h-24z"></path>
    <path class="h" d="M12 4v3M16 4v3M20 4v3M24 4v3M28 4v3"></path>
</svg>

<style>
    .pointing-hand {
        display: block;
        overflow: visible;
    }

    .f {
        fill: var(--color-ground);
        stroke: rgb(227 154 106 / 0.9);
        stroke-width: 1.3;
        stroke-linejoin: round;
    }

    .h {
        fill: none;
        stroke: rgb(227 154 106 / 0.45);
        stroke-width: 0.9;
        stroke-linecap: round;
    }
</style>
