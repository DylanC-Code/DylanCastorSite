---
/**
 * The workshop, phone: the workshop narrowed, without its window, the round
 * hanging sign on its bracket, the gentleman at the right edge facing it.
 * Prototype: `workSec`, the 524 × 310 drawing (compact).
 */
import VisitorFigure from "#/presentation/visitor/floor/ui/VisitorFigure.astro";

interface Props {
    plaque: readonly [string, string];
    hangingSign: readonly [string, string];
    label: string;
}

const { plaque, hangingSign, label } = Astro.props;
const hatch = Array.from(
    { length: 36 },
    (_, i) => `M${10 + i * 14} 294l-7 9`,
).join("");
const eaves = Array.from({ length: 19 }, (_, i) => `M${i * 15} 38v8`).join("");
const door =
    "M160 290V162a40 40 0 0 1 80 0V290M200 122V290M176 130V290M224 130V290";
const bracket = "M280 92h76M280 106q42 0 54 -14M356 92v20";
---

<svg
    class="scene-workshop-phone"
    viewBox="0 0 524 310"
    role="img"
    aria-label={label}
>
    <path class="l" d="M0 290H524"></path>
    <path class="h" d={hatch}></path>
    <g transform="translate(12 0)">
        <path class="l" d="M0 290V50M280 50V290"></path>
        <path class="h" d="M273 60V284M267 110V240"></path>
        <path class="f" d="M-10 34h300v16h-300z"></path>
        <path class="h" d={eaves}></path>
        <path class="f" d="M150 290V160a50 50 0 0 1 100 0V290"></path>
        <path class="h" d={door}></path>
        <circle class="c" cx="190" cy="214" r="3"></circle>
        <path class="l" d="M138 290h124"></path>
        <path class="f" d="M34 150h92v58H34z"></path>
        <path class="h" d="M39 155h82v48H39z"></path>
        <circle class="c" cx="42" cy="158" r="1.3"></circle>
        <circle class="c" cx="118" cy="158" r="1.3"></circle>
        <text class="sn" x="80" y="178" text-anchor="middle">
            {plaque[0]}
        </text>
        <text class="nn" x="80" y="194" text-anchor="middle">
            {plaque[1]}
        </text>
        <path class="l" d={bracket}></path>
        <circle class="f" cx="356" cy="150" r="38"></circle>
        <circle class="h" cx="356" cy="150" r="31"></circle>
        <text class="sn" x="356" y="147" text-anchor="middle">
            {hangingSign[0]}
        </text>
        <text class="sn" x="356" y="163" text-anchor="middle">
            {hangingSign[1]}
        </text>
    </g>
    <g transform="translate(516 0) scale(-1 1)">
        <VisitorFigure x={0} y={122} width={90} height={168} />
    </g>
</svg>

<style>
    .scene-workshop-phone {
        display: block;
        overflow: visible;
    }

    .l {
        fill: none;
        stroke: rgb(227 154 106 / 0.85);
        stroke-width: 1.3;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .f {
        fill: var(--color-ground);
        stroke: rgb(227 154 106 / 0.85);
        stroke-width: 1.3;
        stroke-linejoin: round;
    }

    .h {
        fill: none;
        stroke: rgb(227 154 106 / 0.4);
        stroke-width: 0.9;
        stroke-linecap: round;
    }

    .c {
        fill: rgb(227 154 106 / 0.85);
    }

    .sn {
        font: italic 400 14px var(--font-display);
        fill: var(--color-ink);
    }

    .nn {
        font: 600 7px var(--font-sans);
        letter-spacing: 0.2em;
        fill: var(--color-accent);
    }
</style>
