---
import type { AgencyStepViewModel } from "#/presentation/visitor/agencies/viewmodels/AgencyStepViewModel.ts";

/**
 * One step: a 600px block, its left column (the ghost numeral, "Step n", the
 * title, the sentence with its emphasis in copper) and its visual in the slot.
 */
interface Props {
    step: AgencyStepViewModel;
}

const { step } = Astro.props;
const [before = "", after = ""] = step.sentence.split(step.emphasis);
---

<li class="step" data-step={step.n - 1} id={`step-${step.n}`}>
    <div class="step-text">
        <span aria-hidden="true" class="step-ghost">
            {step.n}
        </span>
        <p class="eyebrow">Step {step.n}</p>
        <h3 class="mt-3 font-display text-[32px] leading-[1.1] text-ink md:mt-4 md:text-[44px] md:leading-[1.08]">
            {step.title}
        </h3>
        <p class="mt-4 font-display text-[19px] leading-[1.38] text-ink md:mt-5 md:text-[24px] md:leading-[1.36]">
            {before}
            <em class="text-accent italic">{step.emphasis}</em>
            {after}
        </p>
        {step.fix !== undefined && <p class="step-fix">{step.fix}</p>}
    </div>
    <div class="step-visual">
        <slot />
    </div>
</li>

<style>
    /* Phones first: the column is the block's top; from 768px it sits beside. */
    .step {
        position: relative;
        box-sizing: border-box;
        min-height: 800px;
        padding: 84px 0 0;
    }

    .step-text {
        position: relative;
    }

    .step-ghost {
        position: absolute;
        top: -40px;
        right: 0;
        z-index: -1;
        font: 400 150px / 1 var(--font-display);
        color: transparent;
        -webkit-text-stroke: 1px rgb(227 154 106 / 0.22);
    }

    .step-fix {
        margin-top: 16px;
        padding-left: 14px;
        border-left: 2px solid var(--color-accent);
        font: italic 400 16px / 1.4 var(--font-display);
        color: var(--color-ink-muted);
    }

    .step-visual {
        margin-top: 24px;
    }

    :global([data-live]) .step {
        opacity: 0.28;
        transition: opacity 500ms var(--ease-out);
    }

    :global([data-live]) .step.is-current {
        opacity: 1;
    }

    @media (min-width: 48rem) {
        .step {
            display: grid;
            grid-template-columns: 340px 1fr;
            gap: 50px;
            height: 600px;
            min-height: 0;
            padding-top: 96px;
        }

        .step-ghost {
            top: -70px;
            right: auto;
            left: -24px;
            font-size: 260px;
        }

        .step-fix {
            margin-top: 20px;
            font-size: 18px;
        }

        .step-visual {
            margin-top: 0;
        }
    }
</style>
