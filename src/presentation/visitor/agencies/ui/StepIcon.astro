---
/** One of the handoff's line icons: a 24 × 24 stroke drawing, copper on paper. */
interface Props {
    name: string;
    icons: Readonly<Record<string, string>>;
    size: number;
}

const { name, icons, size } = Astro.props;
---

<svg
    aria-hidden="true"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.3"
    stroke-linecap="round"
    stroke-linejoin="round"
    set:html={icons[name] ?? ""}
/>
