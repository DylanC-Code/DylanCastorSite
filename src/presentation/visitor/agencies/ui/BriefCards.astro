---
import StepIcon from "#/presentation/visitor/agencies/ui/StepIcon.astro";
import type { IconLineViewModel } from "#/presentation/visitor/agencies/viewmodels/AgencyStepViewModel.ts";

/** Step 1: what you send, six cards dealt into an arc. A real list underneath. */
interface Props {
    cap: string;
    cards: readonly IconLineViewModel[];
    icons: Readonly<Record<string, string>>;
}

const { cap, cards, icons } = Astro.props;
---

<p class="eyebrow">{cap}</p>
<ul class="cards">
    {cards.map((card, index) => (
        <li
            class="card"
            style={`--k: ${index - (cards.length - 1) / 2}; --i: ${index}`}
        >
            <span class="card-head">
                <StepIcon name={card.icon} icons={icons} size={26} />
                <span class="card-number">{index + 1}</span>
            </span>
            <span class="card-word">{card.word}</span>
            <span class="card-text">{card.text}</span>
        </li>
    ))}
</ul>

<style>
    .cards {
        display: grid;
        gap: 12px;
        margin: 16px 0 0;
        padding: 0;
        list-style: none;
    }

    .card {
        display: flex;
        flex-direction: column;
        gap: 6px;
        box-sizing: border-box;
        padding: 16px 14px;
        background: var(--color-paper);
        color: var(--color-paper-ink);
        box-shadow:
            inset 0 0 0 5px var(--color-paper),
            inset 0 0 0 6px rgb(27 26 24 / 0.16),
            0 12px 24px rgb(0 0 0 / 0.45);
    }

    .card-head {
        display: flex;
        justify-content: space-between;
        color: var(--color-paper-copper);
        font: 400 18px / 1 var(--font-display);
    }

    .card-word {
        font: 400 20px / 1.1 var(--font-display);
    }

    .card-text {
        font-size: 12px;
        line-height: 1.42;
    }

    @media (min-width: 48rem) {
        .cards {
            position: relative;
            display: block;
            width: 760px;
            height: 300px;
        }

        .card {
            position: absolute;
            top: 20px;
            left: calc(50% - 70px);
            width: 140px;
            height: 206px;
            transform: translate(
                    calc(var(--k) * 124px),
                    calc(var(--k) * var(--k) * 6px)
                )
                rotate(calc(var(--k) * 4deg));
            transition:
                transform 750ms cubic-bezier(0.3, 1.25, 0.5, 1)
                    calc(500ms + var(--i) * 120ms),
                translate 350ms var(--ease-out);
        }

        .card:hover {
            translate: 0 -14px;
        }

        :global([data-live]) :global(.step:not([data-seen])) .card {
            transform: none;
        }
    }
</style>
