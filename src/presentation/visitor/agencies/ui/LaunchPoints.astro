---
/**
 * Step 4: visitors split between the original and the variant, dots running
 * along the tracks for as long as the step is on screen; each end gets a tick
 * once. From 768px the tracks run left to right; on a phone they flow down.
 * Hidden from assistive tech: the sentence carries the meaning.
 */
interface Props {
    start: string;
    ends: readonly [string, string];
    foot: string;
}

const { start, ends, foot } = Astro.props;
const layouts = [
    {
        name: "wide",
        size: [780, 300],
        tracks: [
            "M20 150 H250 C330 150 330 70 420 70 H650",
            "M20 150 H250 C330 150 330 230 420 230 H650",
        ],
        caps: "M20 144 V156 M650 64 V76 M650 224 V236",
    },
    {
        name: "upright",
        size: [358, 350],
        tracks: [
            "M179 14 V96 C179 150 92 140 92 200 V300",
            "M179 14 V96 C179 150 266 140 266 200 V300",
        ],
        caps: "M171 14 h16 M84 300 h16 M258 300 h16",
    },
];
const dots = [0, 1, 2, 3, 4, 5, 6, 7];
---

{layouts.map(({ name, size: [width, height], tracks, caps }) => (
    <div class:list={["points", `is-${name}`]} aria-hidden="true">
        <svg
            class="points-tracks"
            viewBox={`0 0 ${width} ${height}`}
            width={width}
            height={height}
        >
            {tracks.map((track) => (
                <path d={track} />
            ))}
            <path class="points-cap" d={caps} />
        </svg>
        <span class="points-label is-start">{start}</span>
        <span class="points-label is-upper">
            {ends[0]} <span class="points-tick is-upper">✓</span>
        </span>
        <span class="points-label is-lower">
            {ends[1]} <span class="points-tick is-lower">✓</span>
        </span>
        {dots.map((dot) => (
            <span
                class="points-dot"
                style={`--i: ${dot}; offset-path: path("${tracks[dot % 2] ?? ""}")`}
            />
        ))}
    </div>
))}
<p class="points-foot">{foot}</p>
