---
import StepIcon from "#/presentation/visitor/agencies/ui/StepIcon.astro";
import type { HandoverRowViewModel } from "#/presentation/visitor/agencies/viewmodels/AgencyStepViewModel.ts";

/** Step 3: what you get back, a sample handover sheet, its rows rising in. */
interface Props {
    cap: string;
    sheet: {
        title: string;
        tag: string;
        rows: readonly HandoverRowViewModel[];
        foot: string;
    };
    icons: Readonly<Record<string, string>>;
}

const { cap, sheet, icons } = Astro.props;
---

<p class="eyebrow">{cap}</p>
<div class="sheet">
    <p class="sheet-head">
        <span class="sheet-title">{sheet.title}</span>
        <span class="sheet-tag">{sheet.tag}</span>
    </p>
    <ul class="sheet-rows">
        {sheet.rows.map((row, index) => (
            <li class="sheet-row" title={row.locked} style={`--i: ${index}`}>
                <StepIcon name={row.icon} icons={icons} size={20} />
                <span class="sheet-word">{row.word}</span>
                <span class="sheet-sample">
                    {row.drawing !== undefined && (
                        <span aria-hidden="true" class="sheet-toggle" />
                    )}
                    {typeof row.sample === "string" ? (
                        row.sample
                    ) : (
                        <code>{row.sample.join(" · ")}</code>
                    )}
                </span>
            </li>
        ))}
    </ul>
    <p class="sheet-foot">{sheet.foot}</p>
</div>

<style>
    .sheet {
        position: relative;
        box-sizing: border-box;
        max-width: 640px;
        margin-top: 16px;
        padding: 28px 30px 24px;
        background: var(--color-paper);
        color: var(--color-paper-ink);
        box-shadow:
            inset 0 0 0 8px var(--color-paper),
            inset 0 0 0 9px rgb(27 26 24 / 0.16),
            0 16px 30px rgb(0 0 0 / 0.45);
        rotate: -0.6deg;
    }

    .sheet-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: 0;
    }

    .sheet-title {
        font: italic 400 28px / 1 var(--font-display);
    }

    .sheet-tag {
        padding: 3px 6px;
        border: 1px solid var(--color-ink-red-deep);
        color: var(--color-ink-red-deep);
        font: 600 9px / 1 var(--font-sans);
        letter-spacing: 0.2em;
        text-transform: uppercase;
    }

    .sheet-rows {
        margin: 16px 0 0;
        padding: 0;
        list-style: none;
    }

    .sheet-row {
        display: grid;
        grid-template-columns: 20px 110px 1fr;
        gap: 14px;
        align-items: center;
        padding: 18px 0;
        border-top: 1px solid rgb(27 26 24 / 0.13);
        color: var(--color-paper-copper);
        transition:
            opacity 500ms var(--ease-out) calc(var(--i) * 140ms),
            translate 500ms var(--ease-out) calc(var(--i) * 140ms);
    }

    :global([data-live]) :global(.step:not([data-seen])) .sheet-row {
        opacity: 0;
        translate: 0 12px;
    }

    .sheet-word {
        font: 400 19px / 1.1 var(--font-display);
        color: var(--color-paper-ink);
    }

    .sheet-sample {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
        font-size: 14px;
        line-height: 22px;
        color: var(--color-paper-ink);
    }

    .sheet-sample code {
        font: 400 13px / 22px var(--font-mono);
    }

    .sheet-toggle {
        position: relative;
        width: 28px;
        height: 16px;
        border-radius: 8px;
        background: var(--color-bottle);
    }

    .sheet-toggle::after {
        content: "";
        position: absolute;
        top: 3px;
        right: 3px;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--color-paper);
    }

    .sheet-foot {
        margin: 14px 0 0;
        font-size: 12px;
        color: rgb(27 26 24 / 0.72);
    }
</style>
