---
/**
 * The counter on the shop's wall, centred on (x, y): a box with its word and
 * three digit windows. The street turns its digits (`[data-digit]`).
 */
interface Props {
    x: number;
    y: number;
    word: string;
}

const { x, y, word } = Astro.props;
---

<g class="dial" data-dial>
    <rect class="kf" x={x - 27} y={y - 24} width="54" height="48"></rect>
    <rect class="t" x={x - 23} y={y - 20} width="46" height="40"></rect>
    <text class="sc is-tiny" x={x} y={y - 9} text-anchor="middle">
        {word}
    </text>
    {[0, 1, 2].map((index) => (
        <>
            <rect
                class="sf"
                x={x - 18 + index * 13}
                y={y - 3}
                width="11"
                height="16"
            />
            <text
                class="ser is-digit"
                x={x - 12.5 + index * 13}
                y={y + 9}
                text-anchor="middle"
                data-digit
            >
                0
            </text>
        </>
    ))}
</g>
