---
import { lampRays } from "#/presentation/visitor/check_test/presenters/engravingShapes.ts";
import type { CheckTestPageViewModel } from "#/presentation/visitor/check_test/viewmodels/CheckTestPageViewModel.ts";

/**
 * The store of the plate in copper lines, 380 wide from x: the name band, the
 * scalloped awning, the two glazed doors (a large italic A in ink, B in
 * copper), a small hanging "Open" sign between them, and above the name six
 * lit lamps numbered 1 to 6. Nothing moves.
 */
type Props = Omit<CheckTestPageViewModel["lamps"], "title" | "label"> & {
    x: number;
};

const { x, storeName, doors, sign } = Astro.props;
const scallops = `M0 96${"q23.75 20 47.5 0".repeat(8)}`;
const awningTicks = Array.from(
    { length: 8 },
    (_, index) => `M${23.75 + index * 47.5} 96v9`,
).join("");
const lamps = [0, 1, 2, 3, 4, 5].map((index) => 30 + index * 64);
const doorAt = [
    { left: 40, door: doors[0], copper: false },
    { left: 240, door: doors[1], copper: true },
];
---

<g transform={`translate(${x} 0)`}>
    <path class="l" d="M0 300V96M380 96V300"></path>
    <path class="h" d="M373 108V294M367 150V260M7 118V170"></path>
    <path class="f" d="M-12 50h404v46h-404z"></path>
    <path class="h" d="M-4 58h388M-4 88h388"></path>
    <circle class="c" cx="6" cy="73" r="2"></circle>
    <circle class="c" cx="374" cy="73" r="2"></circle>
    <text class="b is-name" x="190" y="81" text-anchor="middle">
        {storeName}
    </text>
    <path class="l" d={scallops}></path>
    <path class="h" d={awningTicks}></path>
    {doorAt.map(({ left, door, copper }) => (
        <>
            <path class="f" d={`M${left} 300V132h100v168`} />
            <path class="l" d={`M${left + 10} 142h80v100h-80z`} />
            <path
                class="h"
                d={`M${left + 10} 252h80v40h-80zM${left + 68} 148l16 16M${left + 76} 148l8 8`}
            />
            <text
                class:list={["dl", copper && "is-copper"]}
                x={left + 50}
                y="206"
                text-anchor="middle"
            >
                {door.letter}
            </text>
            <text class="nn" x={left + 50} y="230" text-anchor="middle">
                {door.word}
            </text>
            <circle class="c" cx={left + (copper ? 8 : 92)} cy="247" r="3" />
        </>
    ))}
    <path class="l" d="M175 178l15 -13l15 13"></path>
    <circle class="c" cx="190" cy="164" r="1.6"></circle>
    <path class="f" d="M158 178h64v26h-64z"></path>
    <path class="h" d="M162 182h56v18h-56z"></path>
    <text class="nn is-sign" x="190" y="193.5" text-anchor="middle">
        {sign}
    </text>
    <path class="l" d="M26 300h328"></path>
    {lamps.map((lampX, index) => (
        <>
            <path class="l" d={`M${lampX} 50V40`} />
            <path class="h" d={lampRays(lampX)} />
            <circle class="c" cx={lampX} cy="27" r="13" />
            <text class="ln" x={lampX} y="31" text-anchor="middle">
                {index + 1}
            </text>
        </>
    ))}
</g>
