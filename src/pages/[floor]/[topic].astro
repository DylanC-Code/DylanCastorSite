---
import { switcherFor } from "#/content/floors.ts";
import { home } from "#/content/home.ts";
import {
    type TopicPath,
    topicMetaOf,
    topicPageOf,
    topicPaths,
} from "#/content/topicPages.ts";
import HtmlDocument from "#/presentation/shared/document/ui/HtmlDocument.astro";
import CheckTestPage from "#/presentation/visitor/check_test/ui/CheckTestPage.astro";
import FloorPage from "#/presentation/visitor/floor/ui/FloorPage.astro";
import FlickerPage from "#/presentation/visitor/flicker/ui/FlickerPage.astro";
import SiteFrame from "#/presentation/visitor/shared/site_frame/ui/SiteFrame.astro";

/**
 * A floor's topic pages (topicPages.ts): one per published room. "Flicker-free
 * A/B tests" and "Checking a test before launch" are written and open to
 * search; the others are placeholders, hidden until written
 * (searchListing.json).
 */
export function getStaticPaths(): TopicPath[] {
    return topicPaths();
}

type Props = TopicPath["props"];

const { floorId, area, name, roomId } = Astro.props;
const meta = topicMetaOf(roomId, name);
const topic = topicPageOf(roomId);
---

<HtmlDocument title={meta.title} description={meta.description}>
    <SiteFrame
        header={home.header}
        footer={home.footer}
        switcher={switcherFor(floorId)}
    >
        {topic.kind === "flicker" && <FlickerPage {...topic.page} />}
        {topic.kind === "check" && <CheckTestPage {...topic.page} />}
        {topic.kind === "placeholder" && <FloorPage layer={area} area={name} />}
    </SiteFrame>
</HtmlDocument>
