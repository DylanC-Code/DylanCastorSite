---
import { switcherFor } from "#/content/floors.ts";
import { books } from "#/content/books.ts";
import { home } from "#/content/home.ts";
import { pageMeta } from "#/content/pageMeta.ts";
import HtmlDocument from "#/presentation/shared/document/ui/HtmlDocument.astro";
import HomePage from "#/presentation/visitor/home/ui/HomePage.astro";
import SiteFrame from "#/presentation/visitor/shared/site_frame/ui/SiteFrame.astro";
---

<HtmlDocument
    title={pageMeta.home.title}
    description={pageMeta.home.description}
>
    <SiteFrame
        header={home.header}
        footer={home.footer}
        switcher={switcherFor(null)}
    >
        <HomePage
            titlePage={home.hero}
            floorDirectory={home.floors}
            readerShelf={books}
            gettingAround={home.tips}
            contactCard={home.contact}
        />
    </SiteFrame>
</HtmlDocument>
