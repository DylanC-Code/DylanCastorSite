---
import { books } from "#/content/books.ts";
import { switcherFor } from "#/content/floors.ts";
import { home } from "#/content/home.ts";
import { readerPathMeta } from "#/content/pageMeta.ts";
import { readerPathPages } from "#/content/readerPaths.ts";
import HtmlDocument from "#/presentation/shared/document/ui/HtmlDocument.astro";
import ReaderPathHome from "#/presentation/visitor/reader_path/ui/ReaderPathHome.astro";
import { forReader } from "#/presentation/visitor/home/presenters/bookNames.ts";
import type { BookViewModel } from "#/presentation/visitor/home/viewmodels/BookViewModel.ts";
import SiteFrame from "#/presentation/visitor/shared/site_frame/ui/SiteFrame.astro";

/**
 * The reading paths' homes, one per book: the agencies home and the brands
 * home are built, the engineers' is a placeholder. All are kept out of search
 * until their words are final.
 */
export function getStaticPaths(): {
    params: { readerPath: string };
    props: { book: BookViewModel };
}[] {
    return books.books.map((book) => ({
        params: { readerPath: book.href.slice(1) },
        props: { book },
    }));
}

interface Props {
    book: BookViewModel;
}

const { book } = Astro.props;
const title = forReader(book);
const meta = readerPathMeta[book.id] ?? {
    title: `${title} · ${home.header.brand}`,
    description: title,
};
---

<HtmlDocument title={meta.title} description={meta.description} noindex>
    <SiteFrame
        header={home.header}
        footer={home.footer}
        switcher={switcherFor(null)}
    >
        <ReaderPathHome
            book={book}
            title={title}
            labels={books.labels}
            {...readerPathPages}
        />
    </SiteFrame>
</HtmlDocument>
