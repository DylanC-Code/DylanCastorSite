// The form Worker (launch decisions, section 2). Deployed only with Dylan's OK:
// `bun run worker:deploy`. It answers one route of dylancastor.com; every other
// address of the site still goes to the cluster.
{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "dylancastor-form-mail",
    "main": "src/interfaces/form_worker/formWorker.ts",
    "compatibility_date": "2026-11-01",
    "workers_dev": false,
    "routes": [
        {
            "pattern": "dylancastor.com/api/message",
            "zone_name": "dylancastor.com",
        },
    ],
    // Sends through the Gmail API as Dylan's Workspace inbox (17 Nov 2026):
    // Cloudflare's send binding needs Email Routing, which would replace
    // Google's MX records. No DNS record is added. Three secrets, set in the
    // Worker's settings, never here: GOOGLE_CLIENT_EMAIL, GOOGLE_PRIVATE_KEY,
    // INBOX.
    // 2 messages per minute per visitor (Dylan's choice, 15 Nov 2026).
    "ratelimits": [
        {
            "name": "PER_VISITOR",
            "namespace_id": "1001",
            "simple": { "limit": 2, "period": 60 },
        },
    ],
    "vars": {
        "SITE": "https://dylancastor.com",
    },
    "observability": { "enabled": false },
}
